generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Neon) — dev local e produção partilham o mesmo provider/schema;
  // a migração de SQLite (Fase 0-9) para Postgres aconteceu na Fase 10, antes
  // do primeiro deploy real.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Nota: SQLite não suporta enums nativamente no Prisma, por isso status/source/type
// ficam como String, validados na app contra @invoice-scanner/shared (ExpenseType, etc).
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  googleId              String    @unique
  googleRefreshTokenEnc String? // refresh token do Google Sign-In, cifrado (AES-256-GCM) — usado pela Fase 8 (arquivo no Drive)
  googleAuthClientId    String? // client id OAuth que emitiu o refresh token acima — um refresh token só é utilizável pelo cliente que o emitiu (web vs iOS); null = cliente web (linhas antigas)
  driveRootFolderId     String? // não usado até à Fase 8, coluna criada agora para evitar outra migração
  createdAt             DateTime  @default(now())
  expenses              Expense[]
  sessions              Session[]
  monthlyReportStatuses MonthlyReportStatus[]
  expenseCategories     ExpenseCategory[]
  acquirerNifDisplays   AcquirerNifDisplay[]
  supplierVatDefaults   SupplierVatDefault[]
  supplierCategoryDefaults SupplierCategoryDefault[]

  // Classificação de IVA dedutível por fatura — desativada por omissão (produto
  // pré-existente nunca pediu isto). Quando ativa, POST/PATCH /expenses passam a
  // exigir Expense.vatDeductible; vatAutoFillMode escolhe a fonte do
  // pré-preenchimento (nunca as duas ao mesmo tempo — um único campo nullable).
  vatClassificationEnabled Boolean @default(false)
  vatAutoFillMode           String? // "SUPPLIER" | "CATEGORY" | null
}

// Sessão de app (Google Sign-In do utilizador final) — distinta do fluxo OAuth do
// Gmail (poller de ingestão), que não usa nenhuma destas tabelas.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status String @default("SUBMETIDA") // TRATAMENTO_MANUAL | SUBMETIDA
  source String // CAMERA | EMAIL | UPLOAD
  type   String // um dos EXPENSE_TYPES de @invoice-scanner/shared

  supplierName String?
  supplierNif  String?
  acquirerNif  String?
  documentType String?
  documentId   String? // nº do documento (campo G do QR, ex: "FS HOS/3980") — usado para detetar duplicados
  documentDate String? // ISO YYYY-MM-DD
  documentTime String? // HH:MM

  // amountBase/Vat/Total são sempre em EUR (usados em todos os relatórios/somas).
  // Quando currency != "EUR", os valores originais na moeda da fatura ficam em
  // originalAmount* e amountBase/Vat/Total são calculados a partir do câmbio
  // introduzido manualmente (ver validation.tsx / expense/[id].tsx).
  amountBase  Float?
  amountVat   Float?
  amountTotal Float?

  currency           String  @default("EUR")
  originalAmountBase  Float?
  originalAmountVat   Float?
  originalAmountTotal Float?

  qrRawPayload     String?
  originalFilePath String? // caminho relativo em apps/server/uploads (Fase 0); Drive a partir da Fase 1
  driveFileId      String? // Google Drive file id do ficheiro original, preenchido após arquivo bem sucedido

  // null = não classificada (todas as despesas anteriores a esta funcionalidade, e
  // qualquer uma criada com User.vatClassificationEnabled desligado). Só se torna
  // obrigatório escolher true/false quando essa flag de conta está ativa — ver
  // routes/expenses.ts. Nunca é derivado da categoria: cada fatura guarda o seu
  // próprio valor, congelado no momento da submissão.
  vatDeductible Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([documentDate])
  @@index([supplierNif, documentId])
}

// Estado do relatório mensal por NIF adquirente (Aberto | Enviado para contabilista).
// acquirerNif/period usam os sentinelas NO_NIF_KEY/NO_DATE_KEY ("sem-nif"/"sem-data")
// de @invoice-scanner/shared em vez de null, para a unique constraint funcionar sempre.
// userId é opcional (tal como em Expense) para acomodar dados de dev anteriores à
// Fase 7, mas todas as rotas exigem sessão e filtram por utilizador — ver expenses.ts/reports.ts.
model MonthlyReportStatus {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  acquirerNif String
  period      String
  status      String   @default("ABERTO") // ABERTO | ENVIADO_CONTABILISTA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, acquirerNif, period])
}

// Idempotência do polling do Gmail — cada mensagem só é processada uma vez,
// mesmo que não tenha nenhum anexo válido (evita reprocessar para sempre).
model ProcessedEmail {
  id             String   @id @default(uuid())
  gmailMessageId String   @unique
  processedAt    DateTime @default(now())
}

// Categorias de despesa, personalizáveis por utilizador (cada um tem a sua
// própria lista, sem afetar os outros). `key` é o identificador estável
// gravado em Expense.type — nunca muda, mesmo que `label` seja renomeado.
// Um utilizador novo recebe uma cópia dos EXPENSE_TYPES (@invoice-scanner/shared)
// como ponto de partida, com o MESMO `key` que o enum fixo antigo usava — por
// isso despesas já existentes (de antes desta funcionalidade) continuam a
// bater certo com a categoria seed correspondente, sem precisar de migração
// de dados (ver services/expense-categories.service.ts).
// `vatDeductible`: null = não classificada, true = dedutível, false = não
// dedutível — "opcional" por design, não é preciso classificar todas. Desde a
// reformulação do IVA dedutível (ver Expense.vatDeductible), este campo deixou
// de controlar a visibilidade das colunas do relatório e passou a servir só de
// valor por omissão quando User.vatAutoFillMode = "CATEGORY" — cada fatura
// continua a guardar a sua própria classificação, sem retroatividade.
model ExpenseCategory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  key           String
  label         String
  vatDeductible Boolean?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, key])
}

// Etiqueta + ícone personalizados por NIF de adquirente (ex: "Pessoal" com um
// ícone de pessoa, em vez de "NIF 123456789"), por utilizador. Guardado no
// servidor (não no dispositivo) precisamente para sincronizar entre iOS e Web
// — a primeira versão disto era só AsyncStorage local, o que não sincronizava.
model AcquirerNifDisplay {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  acquirerNif String
  label       String?
  icon        String? // nome Ionicons
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, acquirerNif])
}

// Valor de IVA dedutível aprendido por NIF de PRESTADOR (fornecedor) — só é
// escrito/lido quando User.vatAutoFillMode = "SUPPLIER". Cada submissão com
// esse modo ativo "ensina" (upsert) o valor aqui, que passa a pré-preencher a
// próxima fatura do mesmo fornecedor; faturas já submetidas mantêm sempre o
// valor gravado em Expense.vatDeductible, nunca este.
model SupplierVatDefault {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  supplierNif   String
  vatDeductible Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, supplierNif])
}

// Categoria por omissão por NIF de PRESTADOR (fornecedor) — pré-preenche o
// ecrã de validação/edição (sempre alterável fatura a fatura). Ao contrário do
// SupplierVatDefault (aprendizagem silenciosa, condicionada a uma flag de
// conta), este valor só é gravado quando o utilizador confirma explicitamente
// um pedido "queres usar esta categoria como omissão para este fornecedor?",
// mostrado quando o fornecedor ainda não tem nenhuma linha aqui — ver
// hooks/use-supplier-category-defaults.ts e validation.tsx. `categoryKey` é
// uma string solta (sem FK), tal como Expense.type — uma categoria apagada
// entretanto simplesmente deixa de bater com nenhum chip.
model SupplierCategoryDefault {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  supplierNif String
  categoryKey String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, supplierNif])
}
